+def _closest_peak_coordinate_mm(
+    candidates: tuple[tuple[float, float, float], ...],
+    *,
+    expected_xy_mm: tuple[float, float],
+) -> tuple[float, float, float]:
+    return min(
+        candidates,
+        key=lambda value: (value[0] - expected_xy_mm[0]) ** 2 + (value[1] - expected_xy_mm[1]) ** 2,
+    )
+
