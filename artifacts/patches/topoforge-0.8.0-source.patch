+  }
+
+  .control-section {
+    border-right: 0;
+  }
+
+  .field-grid.two {
+    grid-template-columns: repeat(2, minmax(0, 1fr));
+  }
+
+  .segmented button {
+    font-size: 11px;
+  }
+
+  .file-browser {
+    height: calc(100dvh - 24px);
+  }
+
+  .modal-backdrop {
+    padding: 12px;
+  }
+}
