+  jobQueued: "Job queued",
+  jobCompleted: "Job completed",
+  glbLoadFailed: "3D model failed to load",
+  eastAxis: "+X East",
+  northAxis: "+Y North",
+  upAxis: "+Z Up",
+  terrainMode: "Terrain semantics",
+  terrainBest: "Best available",
+  terrainDtm: "DTM",
+  terrainDsm: "DSM",
+  terrainBathymetry: "Bathymetry",
+  tabConfiguration: "Configuration",
+  tabResults: "Results",
+  fileSize: "Size",
+  checksum: "SHA-256",
+  jobStateQueued: "Queued",
+  jobStateRunning: "Running",
+  jobStateCancelling: "Cancelling",
+  jobStateCancelled: "Cancelled",
+  jobStateCompleted: "Completed",
+  jobStateFailed: "Failed",
+  stageAcquire: "Acquire",
+  stageSource: "Source",
+  stageBuild: "Build",
+  stageOverlay: "Overlay",
+  stageLayout: "Layout",
+  stageExtract: "Extract",
+  stageMesh: "Mesh",
+  stageConnect: "Connect",
+  stageSlice: "Slice",
+  stageProject: "Project",
+  loading: "Loading",
+  selectJob: "Select a job",
+  modelPreview: "Model preview",
+  directionContract: "Coordinate contract",
+  osmAttribution: "© OpenStreetMap contributors",
+  advanced: "Advanced resource settings",
+  validationPassed: "Validation passed",
+  validationFailed: "Validation failed",
+  retry: "Retry",
+};
+
+const dictionaries: Record<Language, Record<TranslationKey, string>> = {
+  "zh-CN": zh,
+  en,
+};
+
+export function translate(language: Language, key: TranslationKey): string {
+  return dictionaries[language][key];
+}
+
+export function jobStateKey(state: string): TranslationKey {
+  const key = `jobState${state.charAt(0).toUpperCase()}${state.slice(1)}`;
+  return key as TranslationKey;
+}
+
+export function stageKey(stage: string | null): TranslationKey | null {
+  if (!stage) {
+    return null;
+  }
+  const key = `stage${stage.charAt(0).toUpperCase()}${stage.slice(1)}`;
+  return key as TranslationKey;
+}
